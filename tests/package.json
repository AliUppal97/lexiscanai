{
  "name": "@lexiscan/tests",
  "version": "1.0.0",
  "description": "Comprehensive testing suite for LexiScan AI",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:performance": "jest --testPathPattern=performance --maxWorkers=1",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:db:setup": "cd ../apps/api && npx prisma db push --schema=./prisma/schema.prisma --skip-generate",
    "test:db:migrate": "cd ../apps/api && npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "test:db:reset": "cd ../apps/api && npx prisma migrate reset --schema=./prisma/schema.prisma --force"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@nestjs/testing": "^10.2.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>"],
    "testMatch": [
      "**/__tests__/**/*.+(ts|tsx|js)",
      "**/?(*.)+(spec|test).+(ts|tsx|js)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "collectCoverageFrom": [
      "../apps/api/src/**/*.{js,ts}",
      "!../apps/api/src/**/*.d.ts",
      "!../apps/api/src/**/*.interface.ts",
      "!../apps/api/src/**/*.module.ts",
      "!../apps/api/src/main.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../apps/api/src/$1",
      "^@test/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/global-setup.ts",
    "globalTeardown": "<rootDir>/global-teardown.ts",
    "verbose": true,
    "detectOpenHandles": true,
    "forceExit": true,
    "maxWorkers": "50%"
  }
}

