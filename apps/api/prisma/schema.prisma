  tenantId  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, tenantId])
  @@index([appId])
  @@index([rating])
  @@map("app_reviews")
}

model AppTransaction {
  id         String             @id @default(cuid())
  appId      String
  tenantId   String
  amount     Float
  commission Float // Platform commission
  type       AppTransactionType
  createdAt  DateTime           @default(now())

  // Relations
  app MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("app_transactions")
}

// ============================================================================
// PROPRIETARY AI MODELS INFRASTRUCTURE
// ============================================================================

enum AIModelType {
  LLM
  REASONING
  COMPLIANCE
  DOCUMENT_ANALYSIS
}

enum AIModelStatus {
  TRAINING
  DEPLOYED
  ARCHIVED
}

enum ModelTrainingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ModelDeploymentStatus {
  PENDING
  DEPLOYING
  ACTIVE
  FAILED
  ROLLED_BACK
}

enum ModelDeploymentEnvironment {
  STAGING
  PRODUCTION
}

model AIModel {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        AIModelType
  version     String        @default("1.0.0")
  status      AIModelStatus @default(TRAINING)
  config      Json // Model configuration
  metrics     Json? // Model metrics (accuracy, latency, etc.)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  trainings   ModelTraining[]
  deployments ModelDeployment[]
  versions    ModelVersion[]
  usage       ModelUsage[]

  @@index([type])
  @@index([status])
  @@index([version])
  @@map("ai_models")
}

model ModelTraining {
  id           String              @id @default(cuid())
  modelId      String
  datasetId    String?
  config       Json // Training configuration
  status       ModelTrainingStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  metrics      Json? // Training metrics
  errorMessage String?

  // Relations
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([status])
  @@map("model_trainings")
}

model ModelDeployment {
  id                String                     @id @default(cuid())
  modelId           String
  environment       ModelDeploymentEnvironment @default(STAGING)
  endpoint          String?
  status            ModelDeploymentStatus      @default(PENDING)
  deployedAt        DateTime?
  trafficPercentage Int                        @default(0) // 0-100

  // Relations
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, environment])
  @@index([modelId])
  @@index([status])
  @@map("model_deployments")
}

model ModelVersion {
  id        String   @id @default(cuid())
  modelId   String
  version   String
  config    Json // Version-specific config
  metrics   Json? // Version metrics
  createdAt DateTime @default(now())

  // Relations
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, version])
  @@index([modelId])
  @@map("model_versions")
}

model ModelUsage {
  id        String   @id @default(cuid())
  modelId   String
  tenantId  String
  input     Json? // Input data
  output    Json? // Output data
  latency   Int // Latency in milliseconds
  cost      Float // Cost in USD
  timestamp DateTime @default(now())

  // Relations
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
  @@index([tenantId])
  @@index([timestamp])
  @@map("model_usage")
}
