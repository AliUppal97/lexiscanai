// ============================================================================
// USAGE QUOTAS & ENFORCEMENT SYSTEM
// ============================================================================

enum ResourceType {
  DOCUMENT
  STORAGE
  API_CALL
  USER
  ORGANIZATION
  WEBHOOK
  EMAIL
  SMS
  CUSTOM
}

enum QuotaPeriod {
  DAILY
  MONTHLY
  YEARLY
  LIFETIME
}

enum QuotaAlertType {
  WARNING
  CRITICAL
  EXHAUSTED
}

model QuotaConfig {
  id             String       @id @default(cuid())
  tenantId       String
  resourceType   ResourceType
  limit          BigInt // Quota limit
  period         QuotaPeriod  @default(MONTHLY)
  resetDate      DateTime? // Next reset date
  overageAllowed Boolean      @default(false)
  overageLimit   BigInt? // Maximum overage allowed
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]
  alerts       QuotaAlert[]

  @@unique([tenantId, resourceType, period])
  @@index([tenantId, resourceType])
  @@index([resetDate])
  @@map("quota_configs")
}

model UsageRecord {
  id            String       @id @default(cuid())
  tenantId      String
  resourceType  ResourceType
  quantity      BigInt // Usage quantity
  timestamp     DateTime     @default(now())
  metadata      Json? // Additional metadata
  userId        String? // Optional user who triggered usage
  documentId    String? // Optional document ID
  quotaConfigId String?

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotaConfig QuotaConfig? @relation(fields: [quotaConfigId], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceType, timestamp])
  @@index([timestamp])
  @@index([userId])
  @@index([documentId])
  @@map("usage_records")
}

model QuotaAlert {
  id                  String         @id @default(cuid())
  tenantId            String
  quotaConfigId       String
  alertType           QuotaAlertType
  thresholdPercentage Int // Threshold percentage (50, 75, 90, 100)
  sentAt              DateTime       @default(now())
  acknowledgedAt      DateTime?
  message             String?
  metadata            Json?

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotaConfig QuotaConfig @relation(fields: [quotaConfigId], references: [id], onDelete: Cascade)

  @@index([tenantId, quotaConfigId])
  @@index([sentAt])
  @@map("quota_alerts")
}

