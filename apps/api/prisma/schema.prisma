  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppInstallationStatus {
  ACTIVE
  SUSPENDED
  UNINSTALLED
}

enum AppTransactionType {
  PURCHASE
  SUBSCRIPTION
  USAGE
}

model MarketplaceApp {
  id          String               @id @default(cuid())
