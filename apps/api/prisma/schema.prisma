enum DocumentChangeType {
  INSERT
  DELETE
  UPDATE
  FORMAT
}

model CollaborationSession {
  id          String   @id @default(cuid())
  documentId  String
  tenantId    String
  activeUsers Json // Array of active user IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changes  DocumentChange[]
  comments Comment[]
  presence Presence[]

  @@unique([documentId])
  @@index([tenantId, documentId])
  @@map("collaboration_sessions")
}

model DocumentChange {
  id         String             @id @default(cuid())
  documentId String
  userId     String
  changeType DocumentChangeType
  position   Int // Character position
  content    String? // Changed content
  timestamp  DateTime           @default(now())
  version    Int                @default(1) // Document version after this change

  // Relations
  session CollaborationSession @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@index([documentId, version])
  @@index([timestamp])
  @@map("document_changes")
}

model Comment {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  threadId   String? // Parent comment ID for threaded comments
