enum FeatureFlagTargetType {
  USER
  TENANT
  ENVIRONMENT
  CUSTOM_ATTRIBUTE
}

enum ABTestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0) // 0-100
  targetingRules    Json? // Targeting rules configuration
  dependencies      Json? // Feature flag dependencies
  tenantId          String? // null for global flags
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets     FeatureFlagTarget[]
  variants    FeatureFlagVariant[]
  evaluations FeatureFlagEvaluation[]

  @@index([tenantId, key])
  @@index([enabled])
  @@map("feature_flags")
}

model FeatureFlagTarget {
  id          String                @id @default(cuid())
  flagId      String
  targetType  FeatureFlagTargetType
  targetValue String // User ID, tenant ID, environment, or custom attribute value
  enabled     Boolean               @default(true)

  // Relations
  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, targetType, targetValue])
  @@index([flagId])
  @@map("feature_flag_targets")
}

model FeatureFlagVariant {
  id       String @id @default(cuid())
  flagId   String
  name     String
  value    Json // Variant value (can be any JSON)
  weight   Int    @default(50) // 0-100, distribution weight
  metadata Json?

  // Relations
  flag        FeatureFlag             @relation(fields: [flagId], references: [id], onDelete: Cascade)
  evaluations FeatureFlagEvaluation[]

  @@index([flagId])
  @@map("feature_flag_variants")
}

model FeatureFlagEvaluation {
  id          String   @id @default(cuid())
  flagKey     String
  userId      String?
  tenantId    String
  variantId   String?
  evaluatedAt DateTime @default(now())
  context     Json? // Evaluation context (IP, user agent, etc.)

  // Relations
  variant       FeatureFlagVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  FeatureFlag   FeatureFlag?        @relation(fields: [featureFlagId], references: [id])
  featureFlagId String?

  @@index([flagKey, userId, tenantId])
  @@index([evaluatedAt])
  @@map("feature_flag_evaluations")
}

model ABTest {
  id             String       @id @default(cuid())
  name           String
  description    String?
  flagKeys       Json // Array of feature flag keys
  variants       Json // Variant configuration
  startDate      DateTime
  endDate        DateTime?
  status         ABTestStatus @default(DRAFT)
  successMetrics Json? // Success metrics configuration
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@map("ab_tests")
}

