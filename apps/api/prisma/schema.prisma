  session CollaborationSession @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@index([documentId])
  @@index([threadId])
  @@map("comments")
}

model Presence {
  id             String   @id @default(cuid())
  documentId     String
  userId         String
  cursorPosition Json? // Cursor position {line, column}
